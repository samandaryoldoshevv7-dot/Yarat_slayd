# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=
# Admin(lar) Telegram ID si, vergul bilan (ID ni @userinfobot dan bilib olasiz)
ADMIN_IDS=

# --- AI matn (Claude) ---
# https://console.anthropic.com -> API Keys. Bo'sh qolsa bot DEMO rejimda (namuna matn) ishlaydi.
ANTHROPIC_API_KEY=
# Model. Arzonroq variant: claude-haiku-5-5 (README dagi narx hisobiga qarang)
CLAUDE_MODEL=claude-opus-5-5

# --- Rasmlar (bepul) ---
# https://www.pexels.com/api/ -> bepul kalit. Bo'sh qolsa slaydlar rasmsiz.
PEXELS_API_KEY=

# --- Narxlar (so'm) ---
PRICE_PRESENTATION=2000
WELCOME_BONUS=2000
REFERRAL_BONUS=500

# --- Qo'lda to'lov uchun karta ---
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_CARD_OWNER=Ism Familiya

# Bir vaqtda nechta taqdimot yig'iladi
MAX_PARALLEL=3
