# Railway'da bularni Variables bo'limiga qo'shasiz. Kompyuterda: shu faylni .env deb nusxalang.

# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=
# Admin(lar) Telegram ID si, vergul bilan (ID ni @userinfobot dan bilib olasiz)
ADMIN_IDS=

# --- AI matn: Gemini (BEPUL) ---
# https://aistudio.google.com/apikey -> "Create API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ixtiyoriy, pullik: Claude. Ikkalasi bo'lsa AI_PROVIDER=claude yoki gemini deb tanlaysiz.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_PROVIDER=

# --- Rasmlar ---
# Bo'sh qolsa: Pollinations (bepul AI rasm, kalit kerak emas).
# pexels qo'ysangiz PEXELS_API_KEY ham kerak. none — rasmsiz.
IMAGE_PROVIDER=
PEXELS_API_KEY=

# --- Narxlar (so'm) ---
PRICE_PRESENTATION=2000
WELCOME_BONUS=2000
REFERRAL_BONUS=500

# --- Qo'lda to'lov uchun karta ---
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_CARD_OWNER=Ism Familiya

# Bir vaqtda nechta taqdimot yig'iladi
MAX_PARALLEL=3
